# ---------------------------------------------------------------------------
# Scheduler · configuración
# Los valores por defecto sirven para casi todo el mundo. La API key de Zernio
# NO va aquí: se pega en la interfaz (Cuentas) y se guarda cifrada.
# ---------------------------------------------------------------------------

# Servidor local
HOST=127.0.0.1
PORT=8787

# Código para entrar en la interfaz. Vacío = sin código. MUY recomendable si
# compartes el ordenador: las páginas de administración muestran API keys y
# permiten editar la base de datos.
UI_PASSCODE=

# Otros nombres con los que abres la app, separados por comas (protege del «DNS
# rebinding»); 127.0.0.1 y localhost valen siempre. Detrás de un proxy o por la
# IP de la red, pon aquí ese nombre. «*» = cualquiera.
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Programación
# ---------------------------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Madrid
SCHEDULER_TICK_SECONDS=20
MAX_PUBLISH_ATTEMPTS=3
STATUS_POLL_SECONDS=30
STATUS_TIMEOUT_MINUTES=60
WATCH_FOLDER_ENABLED=true
# Publicados y fallidos que lista la interfaz por cuenta (los más recientes).
# Lo que está por salir se lista siempre entero.
STATE_HISTORY_LIMIT=300

# ---------------------------------------------------------------------------
# Copias de la base de datos. Una automática cada BACKUP_AUTO_HOURS mientras la
# app está abierta (0 = ninguna); se guardan las BACKUP_KEEP últimas. Las que
# hagas a mano (Ajustes → Crear copia) no se borran nunca solas.
# ---------------------------------------------------------------------------
BACKUP_AUTO_HOURS=24
BACKUP_KEEP=14

# ---------------------------------------------------------------------------
# Analíticas. 0 en ANALYTICS_REFRESH_MINUTES las desactiva.
# La ventana es de cuántos días se piden los datos (techo de Zernio: 366).
# ---------------------------------------------------------------------------
ANALYTICS_REFRESH_MINUTES=180
ANALYTICS_WINDOW_DAYS=90

# ---------------------------------------------------------------------------
# Comentarios. Se consultan (no hay webhooks: esto corre en 127.0.0.1).
# Zernio cachea la lista 10 minutos, así que bajar POLL_MINUTES no sirve de nada.
# WINDOW_DAYS: a partir de esa edad, un vídeo deja de consultarse.
# ---------------------------------------------------------------------------
COMMENTS_ENABLED=true
COMMENTS_POLL_MINUTES=30
COMMENTS_WINDOW_DAYS=14
COMMENTS_BATCH=5

# ---------------------------------------------------------------------------
# Textos y hashtags automáticos. Un vídeo que entra en la cola sin texto se
# transcribe en local con Whisper (o, si trae su ficha .txt de ContentBuilder,
# se lee la ficha) y de ahí salen la descripción y los hashtags.
#   WHISPER_MODEL: tiny | base | small | medium | large-v3. "small" (~500 MB,
#     se descarga la primera vez a data/models/whisper) es el punto justo en
#     un portátil: unos segundos por minuto de voz y buen español.
#   WHISPER_LANGUAGE: código de idioma, o vacío para detectarlo en cada vídeo.
#   OLLAMA_URL: un modelo de lenguaje local (Ollama) escribe la descripción
#     (gancho, dato y pregunta) y propone hashtags del tema. Sin él, el texto
#     es la primera frase del vídeo (o el título de su ficha). Vacío = no usar.
#   OLLAMA_MODEL: gemma4:26b es el recomendado (buen español, rápido en Apple
#     Silicon). Vacío = el más pequeño de 4 GB o más, un Gemma primero.
#   OLLAMA_KEEP_ALIVE: cuánto sigue cargado el modelo tras el último texto.
#   CAPTION_EDITOR: segunda pasada que devuelve al modelo sus propios fallos.
#   CAPTION_SHEET_CHECK_SECONDS: segundos de audio que escucha Whisper para
#     confirmar que una ficha .txt es de su vídeo (0 = fiarse del nombre).
#   HASHTAG_MAX: hashtags por vídeo, contando los fijos de Ajustes. TikTok
#     sólo cuenta cinco: más de 5 se recorta.
#   HASHTAG_REACH: cuántos #parati/#fyp añadir al final si hay sitio (0 =
#     ninguno: no dicen de qué va el vídeo).
#   CAPTION_MAX_WAIT_MINUTES: cuánto espera un vídeo a su texto antes de salir
#     con el que tenga. El banco de temas está en data/hashtags.json.
# ---------------------------------------------------------------------------
CAPTION_AI_ENABLED=true
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=2m
CAPTION_EDITOR=true
CAPTION_SHEET_CHECK_SECONDS=20
HASHTAG_MAX=5
HASHTAG_REACH=0
CAPTION_MAX_WAIT_MINUTES=10

# ---------------------------------------------------------------------------
# Avisos opcionales. Se reconoce el servicio por la URL:
#   https://discord.com/api/webhooks/...                         Discord
#   https://hooks.slack.com/services/...                         Slack
#   https://ntfy.sh/un-tema-secreto                              ntfy (push al móvil)
#   https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID> Telegram
# Lo que pongas en Ajustes (interfaz) tiene prioridad sobre este valor.
# ---------------------------------------------------------------------------
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Cifrado de tokens. Si lo dejas vacío se genera una clave en .secrets/
# Para fijarla:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Avanzado. Descomenta sólo si sabes por qué lo haces.
# ---------------------------------------------------------------------------
# Mover la base de datos, las copias o las carpetas de vídeo a otro sitio:
# DATABASE_URL=sqlite:////ruta/absoluta/scheduler.db
# BACKUPS_DIR=/ruta/a/copias
# MEDIA_INBOX_DIR=/ruta/a/entrada
# MEDIA_POSTED_DIR=/ruta/a/publicados
# MEDIA_FAILED_DIR=/ruta/a/fallidos
# SECRETS_DIR=/ruta/a/.secrets

# Arrancar aunque otra copia de la app parezca estar usando esta base de datos
# (se niega para no publicar dos veces). Sólo si sabes que la otra ya no existe.
# INSTANCE_TAKEOVER=false

# La API de Zernio. Sólo se cambia para pruebas (tools/mock_zernio.py).
# ZERNIO_API_BASE=https://zernio.com/api/v1
# Tiempo máximo para entregar un vídeo (segundos) y minutos que se espera la
# URL del vídeo en TikTok tras publicar.
# ZERNIO_TIMEOUT_SECONDS=600
# ZERNIO_URL_GRACE_MINUTES=5

# Entregar la cola entera a Zernio («mandar la cola a Zernio de golpe»).
# Vídeos que se suben por ciclo (uno a uno para no acaparar la conexión),
# cada cuántos minutos se pregunta por uno ya programado cuya hora ha pasado,
# y cuánto se espera antes de darlo por fallido: Zernio retiene los posts que
# superan los 15/día de TikTok y los suelta cuando la ventana deja hueco, así
# que la espera es larga a propósito.
# DELEGATE_BATCH_PER_TICK=1
# DELEGATED_POLL_MINUTES=10
# DELEGATED_TIMEOUT_HOURS=48

